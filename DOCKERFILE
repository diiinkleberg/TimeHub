
ARG NODE_VERSION=24-alpine3.21
FROM node:${NODE_VERSION} AS base

WORKDIR /app

# enable corepack so pnpm is available
RUN corepack enable

# Install dev dependencies (cached)
FROM base AS deps
ENV NODE_ENV=development
COPY package.json pnpm-lock.yaml ./
RUN --mount=type=cache,id=pnpm-store,target=/root/.local/share/pnpm \
  pnpm install --frozen-lockfile

# Build stage: generate Prisma client and build Nuxt
FROM base AS build
ENV NODE_ENV=production

# bring dev node_modules so codegen can run
COPY --from=deps /app/node_modules ./node_modules
COPY . .

RUN pnpm run db:generate

# Build Nuxt / Nitro output
RUN pnpm run build

# Install production dependencies only
FROM base AS prod-deps
ENV NODE_ENV=production
COPY package.json pnpm-lock.yaml ./
RUN --mount=type=cache,id=pnpm-store,target=/root/.local/share/pnpm \
  pnpm install --frozen-lockfile --prod

# bring prisma schema to run generate in prod deps layer
COPY --from=build /app/server/lib/db ./server/lib/db

# regenerate Prisma client so runtime deps include engines
RUN pnpm dlx prisma generate --schema=./server/lib/db/schema.prisma

# Final runtime image
FROM node:${NODE_VERSION} AS runner
WORKDIR /app
ENV NODE_ENV=production

# utilities for healthcheck
RUN apk add --no-cache curl

# non-root user
RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 appuser

# copy runtime deps and built output
COPY --from=prod-deps /app/node_modules ./node_modules
COPY --from=build /app/.output ./.output
COPY --from=build /app/package.json ./package.json

USER appuser

EXPOSE 3000
ENV PORT=3000
ENV HOST=0.0.0.0

# healthcheck expects a /health route
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD curl -fsS http://localhost:3000/health || exit 1

CMD ["node", ".output/server/index.mjs"]
{
  "name": "TimeHub",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "cleanup": "nuxt cleanup",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "typecheck": "nuxt typecheck",
    "auth:generate": "npx @better-auth/cli@latest generate --config ./server/lib/auth.config.ts --output ./server/lib/db/migrations/better-auth.sql",
    "auth:migrate": "npx @better-auth/cli@latest migrate --config ./server/lib/auth.config.ts"
  },
  "dependencies": {
    "@nuxt/devtools": "3.0.0-beta.1",
    "@nuxt/fonts": "0.11.4",
    "@nuxt/test-utils": "3.20.1",
    "@nuxt/ui": "^4.1.0",
    "@pinia/nuxt": "0.11.2",
    "@vueuse/nuxt": "14.0.0",
    "better-auth": "^1.3.32",
    "date-fns": "^4.1.0",
    "nuxt": "^4.2.0",
    "pinia": "^3.0.3",
    "pinia-plugin-persistedstate": "4.5.0",
    "prettier": "^3.6.2",
    "tarn": "^3.0.2",
    "tedious": "^18.6.1",
    "vite": "^7.1.12",
    "vue": "^3.5.22",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.9.0",
    "eslint": "^9.38.0",
    "rollup-plugin-visualizer": "^6.0.5",

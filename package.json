{
  "name": "TimeHub",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev ",
    "cleanup": "nuxt cleanup",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "typecheck": "nuxt typecheck",
    "db:generate": "prisma generate --schema=./server/lib/db/schema.prisma",
    "auth:generate": "npx @better-auth/cli generate --config server/lib/auth.config.ts --output server/lib/db/schema.prisma",
    "db:push": "prisma db push --schema=./server/lib/db/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=./server/lib/db/schema.prisma",
    "db:studio": "prisma studio --schema=./server/lib/db/schema.prisma"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.71",
    "@iconify-json/simple-icons": "^1.2.56",
    "@nuxt/scripts": "0.13.0",
    "@nuxt/test-utils": "3.20.1",
    "@nuxt/ui": "^4.1.0",
    "@pinia/nuxt": "0.11.2",
    "@prisma/client": "^6.18.0",
    "@unhead/vue": "^2.0.19",
    "@unovis/ts": "^1.6.1",
    "@unovis/vue": "^1.6.1",
    "@vueuse/nuxt": "^13.9.0",
    "better-auth": "^1.3.34",
    "date-fns": "^4.1.0",
    "nuxt": "^4.2.0",
    "openai": "^6.8.1",
    "pinia": "^3.0.3",
    "pinia-plugin-persistedstate": "4.5.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.3.34",
    "@nuxt/eslint": "^1.10.0",
    "@types/node": "^24.9.2",
    "eslint": "^9.38.0",
    "prisma": "^6.18.0",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.1.2"
  },
  "resolutions": {
    "unimport": "4.1.1"
  },
  "packageManager": "pnpm@10.19.0"
}